{
  "schema": 2,
  "environment": "example",
  "ccp_url": "https://ccp.example.com",
  "enduser": {
    "name": "psmp-test-user",
    "ccp": {
      "app_id": "PSMP-HealthTest",
      "safe": "PSMPTestUser",
      "object": "psmp-test-user"
    }
  },
  "defaults": {
    "psmp_server": "psmp01.example.com",
    "psmp_port": 22
  },
  "test": {
    "hold_seconds": 60,
    "reason": "automated psmp health test"
  },
  "reliability": {
    "retries": 1,
    "retry_wait_sec": 30,
    "alert_after_failures": 1,
    "row_timeout_sec": 600,
    "max_run_minutes": 120,
    "heartbeat_hours": 6,
    "parallel": 1
  },
  "prechecks": {
    "enabled": true
  },
  "outputs": {
    "json": true,
    "history": true,
    "syslog": false,
    "webhook_url": "",
    "keep_days": 30
  },
  "mail": {
    "smtp_host": "mail.example.com",
    "smtp_port": 25,
    "from": "psmphealth@example.com",
    "to": [
      "ops-alerts@example.com"
    ],
    "send_on": "failure",
    "repeat_hours": 6,
    "dry_run": true,
    "subject_prefix": "[PSMP health]"
  }
}